HEALTHCHECK_URL=http://127.0.0.1:8000/health

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=app
MONGO_PASSWORD=app
MONGO_DATABASE=kvint
MONGO_AUTH_SOURCE=admin
MONGO_CONNECT_TIMEOUT_SECONDS=10
MONGO_OPERATION_TIMEOUT_SECONDS=10

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=calls
RABBITMQ_CONNECT_TIMEOUT_SECONDS=10

CONSUMER_RETRY_DELAY_SECONDS=3
CONSUMER_SHUTDOWN_TIMEOUT_SECONDS=10
