{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {"()": "app.logging.make_formatter"}
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json"
    }
  },
  "root": {"handlers": ["stdout"], "level": "INFO"},
  "loggers": {
    "uvicorn": {"handlers": [], "propagate": true, "level": "INFO"},
    "uvicorn.error": {"handlers": [], "propagate": true, "level": "INFO"},
    "uvicorn.access": {"handlers": [], "propagate": false, "level": "CRITICAL"},
    "aio_pika": {"handlers": [], "propagate": true, "level": "WARNING"},
    "aiormq": {"handlers": [], "propagate": true, "level": "WARNING"},
    "pymongo": {"handlers": [], "propagate": true, "level": "WARNING"}
  }
}
